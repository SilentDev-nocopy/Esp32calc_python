#compdef resiris

_resiris() {
    _arguments \
        '1:Resiris source file:_files -g "*.resy"' \
        '--enable-frontend-visibility[Show tokenizer and parser output after running]' \
        '--disable-frontend-visibility[Disable tokenizer and parser output]' \
        '--help[Show this help message]' \
        '--version[Show the Resiris version]'
}

_resiris "$@"
