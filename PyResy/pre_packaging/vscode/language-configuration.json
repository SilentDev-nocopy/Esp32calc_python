{
  "comments": {
    "lineComment": "##"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:.*:)\\s*(?:##.*)?$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:START|PROCESS|fn)\\b.*:\\s*(?:##.*)?$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*(?:if|elif|else|mat)\\b.*:\\s*(?:##.*)?$",
      "action": {
        "indent": "indent"
      }
    }
  ]
}
