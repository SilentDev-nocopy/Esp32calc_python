#!/usr/bin/env bash
set -euo pipefail

SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
PYTHON="/usr/bin/python3"

if [[ ! -x "$PYTHON" ]]; then
    echo "ERROR: /usr/bin/python3 was not found." >&2
    exit 1
fi

export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"

exec "$PYTHON" -m resiris "$@"
