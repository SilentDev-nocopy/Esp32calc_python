fn conversion_test(value):
	v converted_float float = value.type(float)
	v converted_string string = value.type(string)
	v converted_bool bool = value.type(bool)
	print_cmd(value)
	print_cmd(converted_float)
	print_cmd(converted_string)
	print_cmd(converted_bool)
	return converted_float
v function_input int = 77
v function_result float = conversion_test(function_input)
print_cmd(function_input)
print_cmd(function_result)
fn bool_test(value):
	v result bool = value.type(bool)
	print_cmd(result)
	return result
v bool_test_a int = 10
v bool_test_b int = 0
v bool_test_c int = -10
bool_test(bool_test_a)
bool_test(bool_test_b)
bool_test(bool_test_c)
