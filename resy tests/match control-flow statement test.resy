## --------------------------------------------
## 21. MAT INSIDE FUNCTION
## --------------------------------------------

fn function_mat():
	v function_value int = 2

	mat function_value:
		1:
			print_cmd("TEST 28: function case 1 FAIL")
		2:
			print_cmd("TEST 28: function case 2 PASS")
		else:
			print_cmd("TEST 28: function else FAIL")

	print_cmd("TEST 28: function after mat PASS")


function_mat()


## --------------------------------------------
## 22. MAT INSIDE IF
## --------------------------------------------

v if_value bool = true

if if_value:
	v if_mat_value int = 3

	mat if_mat_value:
		1:
			print_cmd("TEST 29: if/mat case 1 FAIL")
		2:
			print_cmd("TEST 29: if/mat case 2 FAIL")
		3:
			print_cmd("TEST 29: if/mat case 3 PASS")
		else:
			print_cmd("TEST 29: if/mat else FAIL")


## --------------------------------------------
## 23. RETURN FROM MATCH CASE
## --------------------------------------------

fn return_mat():
	v return_value int = 10

	mat return_value:
		10:
			return 123
		else:
			return 999

v return_result int = return_mat()

mat return_result:
	123:
		print_cmd("TEST 30: return from mat PASS")
	else:
		print_cmd("TEST 30: return from mat FAIL")


