## --------------------------------------------
## 1. INT MATCH - EVERY CASE
## --------------------------------------------

v int_one int = 1
v int_two int = 2
v int_three int = 3

mat int_one:
	1:
		print_cmd("TEST 01: int case 1 PASS")
	2:
		print_cmd("TEST 01: int case 2 FAIL")
	3:
		print_cmd("TEST 01: int case 3 FAIL")

mat int_two:
	1:
		print_cmd("TEST 02: int case 1 FAIL")
	2:
		print_cmd("TEST 02: int case 2 PASS")
	3:
		print_cmd("TEST 02: int case 3 FAIL")

mat int_three:
	1:
		print_cmd("TEST 03: int case 1 FAIL")
	2:
		print_cmd("TEST 03: int case 2 FAIL")
	3:
		print_cmd("TEST 03: int case 3 PASS")


## --------------------------------------------
## 2. INT ELSE
## --------------------------------------------

v int_else int = 99

mat int_else:
	1:
		print_cmd("TEST 04: FAIL")
	2:
		print_cmd("TEST 04: FAIL")
	else:
		print_cmd("TEST 04: int else PASS")


## --------------------------------------------
## 3. INT - NO MATCH, NO ELSE
## --------------------------------------------

print_cmd("TEST 05: before no-match")

v int_no_match int = 100

mat int_no_match:
	1:
		print_cmd("TEST 05: FAIL")
	2:
		print_cmd("TEST 05: FAIL")

print_cmd("TEST 05: after no-match PASS")


