		print_cmd("TEST 10: string one PASS")
	"two":
		print_cmd("TEST 10: string two FAIL")
	"three":
		print_cmd("TEST 10: string three FAIL")

mat text_two:
	"one":
		print_cmd("TEST 11: string one FAIL")
	"two":
		print_cmd("TEST 11: string two PASS")
	"three":
		print_cmd("TEST 11: string three FAIL")

mat text_three:
	"one":
		print_cmd("TEST 12: string one FAIL")
	"two":
		print_cmd("TEST 12: string two FAIL")
	"three":
		print_cmd("TEST 12: string three PASS")


